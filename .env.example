# D optimize 原型读取此配置；进程环境变量优先于本地 .env。
# 复制为 .env 后填写；不要提交真实密钥。
# custom 使用 HTTPS JSON Chat Completions 协议；base 包含服务要求的 /v1 等前缀。
# 请求地址为 LLM_BASE_URL + /chat/completions。不支持 claude-cli。
LLM_BACKEND=custom
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048
# DeepSeek 可选参数；其他兼容服务不支持时删除此行。
LLM_THINKING=disabled
